{
  "rules": {},
  "env": {
    "es6": true,
    "node": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "overrides": [
    {
      "files": ["cypress/**/*.{js,jsx,ts,tsx}", "cypress.config.js"],
      "env": {
        "cypress/globals": true
      },
      "plugins": ["cypress"]
    }
  ]
}
